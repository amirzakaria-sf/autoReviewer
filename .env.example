DATABASE_URL=postgresql+asyncpg://whipguard:whipguard@postgres:5432/whipguard

# Model provider: azure | bedrock | nvidia | openrouter (anything else refuses
# to start). "bedrock" (production): Amazon Bedrock's OpenAI-compatible
# mantle endpoint, signed with the host's IAM role -- no key goes here; the
# role needs bedrock-mantle:CreateInference. "azure": set the AZURE_* block.
# "nvidia" / "openrouter": set that block below. Their role models come from
# that block, never from LLM_*_MODEL (mantle ids are a 404 there).
LLM_PROVIDER=bedrock
BEDROCK_REGION=eu-north-1
# A Bedrock model id or an Azure deployment name, per LLM_PROVIDER.
# (AZURE_*_DEPLOYMENT are still accepted as the old names for these.)
LLM_FAST_MODEL=moonshotai.kimi-k2.5
LLM_WORKER_MODEL=zai.glm-5
LLM_PLANNER_MODEL=zai.glm-5
LLM_MECHANICAL_MODEL=moonshotai.kimi-k2.5
# "azure" or "none". Empty follows LLM_PROVIDER (bedrock -> none: no
# embeddings model is available there, dense retrieval switches off).
EMBEDDINGS_PROVIDER=

# NVIDIA API Catalog (LLM_PROVIDER=nvidia). Bearer "nvapi-..." key from
# build.nvidia.com; free tier ~40 requests/min per key, 4-130 s per call,
# not EU in-region. Empty role models take NVIDIA_MODEL.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_FAST_MODEL=
NVIDIA_WORKER_MODEL=
NVIDIA_PLANNER_MODEL=
NVIDIA_MECHANICAL_MODEL=
# auto (off for reasoning effort none, on otherwise) | on | off
NVIDIA_THINKING=auto
NVIDIA_TIMEOUT_SECONDS=180

# OpenRouter (LLM_PROVIDER=openrouter). ":free" is the $0, rate-limited
# route; the id without it is paid. Empty role models take OPENROUTER_MODEL.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FAST_MODEL=
OPENROUTER_WORKER_MODEL=
OPENROUTER_PLANNER_MODEL=
OPENROUTER_MECHANICAL_MODEL=
OPENROUTER_TIMEOUT_SECONDS=120

AZURE_API_ENDPOINT=
AZURE_API_KEY=
AZURE_OPENAI_API_VERSION=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: a real GitHub App identity (Settings -> Developer settings ->
# GitHub Apps -> <app> -> Private keys -> Generate a private key). A
# DIFFERENT credential shape than GITHUB_CLIENT_ID/SECRET above (which is an
# OAuth App) -- when both of these are set, every GitHub write acts as the
# App's own bot identity instead of whichever human's OAuth token is
# configured. Leave unset to keep using GITHUB_TOKEN unchanged.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# First-boot admin. Do not leave the code defaults in a reachable deploy.
ADMIN_PASSWORD=
SESSION_SECRET=
NOTIFY_EMAIL=

# Operator console (console.zakarias.in). Must equal WHIPGUARD_CONSOLE_TOKEN in console/deploy/.env.
# Under 32 characters = unconfigured: every /api/console/v1/* route answers 404.
CONSOLE_API_TOKEN=
# Where the "Review request" button in the new-request mail points (empty = the in-app admin page).
CONSOLE_REVIEW_URL=
# true = the in-app admin hides access-request review and Redeploy and points to the operator console. UI only; unset restores them.
CONSOLE_MANAGED=false
CONSOLE_PUBLIC_URL=https://console.zakarias.in
# Email-code step on the accept-invite page (skipped when SMTP is off and for the first account). false = old behaviour.
INVITE_REQUIRE_OTP=true
# Request-received and welcome mails. false = old behaviour (approved / declined / OTP mails are not affected).
ACCESS_LIFECYCLE_EMAILS=true

# Brevo SMTP (invites, fix-proposed mail, signed approve/reject links).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_KEY=
EMAIL_FROM_ADDRESS=

# Web Push (VAPID). Public key: base64url P-256 point; private: raw 43-char scalar.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=
PUBLIC_BASE_URL=https://whip-guard.zakarias.in

# Tests and a local venv only. Unset (the default) in docker-compose.
# ALLOW_INSECURE_DEFAULTS=true

FIXTURE_REPO=owner/repo

# Where clones live on the HOST (bind-mounted at the same path in containers).
WORKSPACE_HOST_ROOT=/srv/workspace

# Local (venv) dev only — leave unset when running via docker-compose, where
# /srv/workspace (the built-in default) is already correct.
# WORKSPACE_ROOT=/absolute/path/to/this/repo/workspace

ASSURANCE_THRESHOLD=75
RESOLUTION_THRESHOLD=80
